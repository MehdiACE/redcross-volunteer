{
  "AllowedOrigins": ["http://localhost:4200"],
  "Auth": {
    "Authority": "https://login.microsoftonline.com/<tenant-id>/v2.0",
    "Audience": "api://redcrossmanager-server"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "ApplicationInsights": {
    "ConnectionString": "InstrumentationKey=<dev-key>"
  }
}
