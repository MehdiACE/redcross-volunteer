{
  "AllowedOrigins": ["http://localhost:4200"],
  "Jwt": {
    "Issuer": "redcross-manager",
    "Audience": "redcross-manager-client",
    "Key": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET",
    "AccessTokenMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "ApplicationInsights": {
    "ConnectionString": "InstrumentationKey=<dev-key>"
  }
}
